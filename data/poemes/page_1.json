{
  "page": 1,
  "recueil": "Cahiers de Douai",
  "auteur": "Arthur Rimbaud",
  "poemes": [
    {
      "id": "premiere_soiree",
      "titre": "Première soirée",
      "date": "1870",
      "auteur": "Arthur Rimbaud",
      "recueil": "Cahiers de Douai",
      "contexte": [
        "Écrit pendant l'été 1870 lors des premiers vagabondages de Rimbaud.",
        "Poème de la sensualité adolescente et du jeu érotique."
      ],
      "forme": [
        "Poème composé de 9 quatrains.",
        "Mètre : octosyllabes.",
        "Rimes croisées (ABAB)."
      ],
      "champs": {
        "sensualite": {
          "label": "Sensualité & Rire"
        },
        "nature": {
          "label": "Nature & Intimité"
        }
      },
      "strophes": [
        {
          "id": "s1",
          "nom": "Strophe 1",
          "vers": "Quatrain - Octosyllabes"
        },
        {
          "id": "s2",
          "nom": "Strophe 2",
          "vers": "Quatrain - Octosyllabes"
        }
      ],
      "lignes": [
        {
          "n": 1,
          "strophe": "s1",
          "texte": "Elle était fort déshabillée",
          "rime": "é",
          "procede": "Proposition affirmative",
          "effet": "Mise en scène immédiate de l'intimité.",
          "champs": [
            "sensualite"
          ]
        },
        {
          "n": 2,
          "strophe": "s1",
          "texte": "Et de grands arbres indiscrets",
          "rime": "è",
          "procede": "Personnification",
          "effet": "La nature semble participer à la scène.",
          "champs": [
            "nature"
          ]
        },
        {
          "n": 3,
          "strophe": "s1",
          "texte": "Aux vitres jetaient leur feuillée",
          "rime": "é",
          "procede": "Image poétique",
          "effet": "Cadre naturel entourant la chambre.",
          "champs": [
            "nature"
          ]
        },
        {
          "n": 4,
          "strophe": "s1",
          "texte": "Malicieusement, tout près.",
          "rime": "è",
          "procede": "Adverbe de manière",
          "effet": "Ton complice et badin.",
          "champs": [
            "sensualite"
          ]
        }
      ]
    },
    {
      "id": "sensation",
      "titre": "Sensation",
      "date": "Mars 1870",
      "auteur": "Arthur Rimbaud",
      "recueil": "Cahiers de Douai",
      "contexte": [
        "L'un des poèmes les plus célèbres du jeune Rimbaud.",
        "Exprime le désir d'évasion, de fusion avec la nature et de liberté."
      ],
      "forme": [
        "Deux quatrains.",
        "Mètre : alexandrins (12 syllabes).",
        "Rimes croisées (ABAB)."
      ],
      "champs": {
        "nature": {
          "label": "Nature & Sensation"
        },
        "voyage": {
          "label": "Vagabondage & Amour"
        }
      },
      "strophes": [
        {
          "id": "s1",
          "nom": "Strophe 1",
          "vers": "Quatrain - Alexandrins"
        },
        {
          "id": "s2",
          "nom": "Strophe 2",
          "vers": "Quatrain - Alexandrins"
        }
      ],
      "lignes": [
        {
          "n": 1,
          "strophe": "s1",
          "texte": "Par les poésies soirs d'été, j'irai dans les sentiers,",
          "rime": "é",
          "procede": "Evocation temporelle",
          "effet": "Atmosphère paisible du soir d'été.",
          "champs": [
            "nature"
          ]
        },
        {
          "n": 2,
          "strophe": "s1",
          "texte": "Picoté par les blés, piétiner l'herbe menue :",
          "rime": "u",
          "procede": "Sensations tactiles (allitérations)",
          "effet": "Contact direct et physique avec la nature.",
          "champs": [
            "nature"
          ]
        },
        {
          "n": 3,
          "strophe": "s1",
          "texte": "Rêveur, j'en sentirai la fraîcheur à mes pieds.",
          "rime": "é",
          "procede": "Champ lexical des sens",
          "effet": "Bien-être et communion sensorielle.",
          "champs": [
            "nature"
          ]
        },
        {
          "n": 4,
          "strophe": "s1",
          "texte": "Je laisserai le vent baigner ma tête nue.",
          "rime": "u",
          "procede": "Metaphore du vent-eau",
          "effet": "Impression de liberté pure.",
          "champs": [
            "nature",
            "voyage"
          ]
        },
        {
          "n": 5,
          "strophe": "s2",
          "texte": "Je ne parlerai pas, je ne penserai rien :",
          "rime": "i",
          "procede": "Double négation / Parallélisme",
          "effet": "Lâcher-prise et méditation silencieuse.",
          "champs": [
            "voyage"
          ]
        },
        {
          "n": 6,
          "strophe": "s2",
          "texte": "Mais l'amour infini me metera dans l'âme,",
          "rime": "â",
          "procede": "Hyperbole / Abstraction",
          "effet": "Plénitude spirituelle et sentimentale.",
          "champs": [
            "voyage"
          ]
        },
        {
          "n": 7,
          "strophe": "s2",
          "texte": "Et j'irai loin, bien loin, comme un bohémien,",
          "rime": "i",
          "procede": "Répétition / Comparaison",
          "effet": "Thème du vagabond indépendant.",
          "champs": [
            "voyage"
          ]
        },
        {
          "n": 8,
          "strophe": "s2",
          "texte": "Par la Nature, - heureux comme avec une femme.",
          "rime": "â",
          "procede": "Personnification majuscule",
          "effet": "La Nature devient l'amante idéale.",
          "champs": [
            "nature",
            "voyage"
          ]
        }
      ]
    }
  ]
}