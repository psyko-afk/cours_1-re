{
 "page": 4,
 "recueil": "Cahiers de Douai",
 "auteur": "Arthur Rimbaud",
 "poemes": [
  {
   "id": "chatiment_de_tartufe",
   "titre": "Châtiment de Tartufe",
   "date": "1870",
   "auteur": "Arthur Rimbaud",
   "contexte": [
    "Critique violente de l'hypocrisie religieuse et de la censure napoléonienne."
   ],
   "forme": [
    "Alexandrins, sonnet ou quatrains."
   ],
   "champs": {
    "religion": {
     "label": "Religion & Hypocrisie"
    }
   },
   "strophes": [
    {
     "id": "s1",
     "nom": "Strophe 1",
     "vers": "Quatrain - Alexandrins"
    },
    {
     "id": "s2",
     "nom": "Strophe 2",
     "vers": "Quatrain - Alexandrins"
    },
    {
     "id": "s3",
     "nom": "Strophe 3",
     "vers": "Tercet - Alexandrins"
    },
    {
     "id": "s4",
     "nom": "Strophe 4",
     "vers": "Tercet - Alexandrins"
    }
   ],
   "lignes": [
    {
     "n": 1,
     "strophe": "s1",
     "texte": "Tisonnant, tisonnant son cœur amoureux sous",
     "rime": "ou",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 2,
     "strophe": "s1",
     "texte": "Sa chaste robe noire, heureux, la main gantée,",
     "rime": "ée",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 3,
     "strophe": "s1",
     "texte": "Un jour qu'il s'en allait, effroyablement doux,",
     "rime": "oux",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 4,
     "strophe": "s1",
     "texte": "Jaune, bavant la foi de sa bouche édentée,",
     "rime": "ée",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 5,
     "strophe": "s2",
     "texte": "Un jour qu'il s'en allait, « Oremus », — un Méchant",
     "rime": "ant",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 6,
     "strophe": "s2",
     "texte": "Le prit rudement par son oreille benoîte :",
     "rime": "oît",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 7,
     "strophe": "s2",
     "texte": "Et lui jeta des mots affreux, en arrachant",
     "rime": "ant",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 8,
     "strophe": "s2",
     "texte": "Sa chaste robe noire autour de sa peau moite !",
     "rime": "oit",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 9,
     "strophe": "s3",
     "texte": "Châtiment !… Ses habits étaient déboutonnés,",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 10,
     "strophe": "s3",
     "texte": "Et le long chapelet des péchés pardonnés",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 11,
     "strophe": "s3",
     "texte": "S'égrenait dans son cœur, Saint Tartufe était pâle !…",
     "rime": "âl",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 12,
     "strophe": "s4",
     "texte": "Donc, il se confessait, priait, avec un râle !",
     "rime": "âl",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 13,
     "strophe": "s4",
     "texte": "L'homme se contenta d'emporter ses rabats…",
     "rime": "at",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    },
    {
     "n": 14,
     "strophe": "s4",
     "texte": "— Peuh ! Tartufe était nu du haut jusques en bas !",
     "rime": "a",
     "procede": "",
     "effet": "",
     "champs": [
      "religion"
     ]
    }
   ]
  },
  {
   "id": "venus_anadyomène",
   "titre": "Vénus anadyomène",
   "date": "1870",
   "auteur": "Arthur Rimbaud",
   "contexte": [
    "Parodie de la naissance de Vénus et de la peinture académique.",
    "Peinture réaliste et caustique d'une femme sortant de son bain."
   ],
   "forme": [
    "Forme de sonnet (alexandrins)."
   ],
   "champs": {
    "corps": {
     "label": "Corps & Parodie"
    }
   },
   "strophes": [
    {
     "id": "s1",
     "nom": "Strophe 1",
     "vers": "Quatrain - Alexandrins"
    },
    {
     "id": "s2",
     "nom": "Strophe 2",
     "vers": "Quatrain - Alexandrins"
    },
    {
     "id": "s3",
     "nom": "Strophe 3",
     "vers": "Tercet - Alexandrins"
    },
    {
     "id": "s4",
     "nom": "Strophe 4",
     "vers": "Tercet - Alexandrins"
    }
   ],
   "lignes": [
    {
     "n": 1,
     "strophe": "s1",
     "texte": "Comme d'un cercueil vert en fer blanc, une tête",
     "rime": "êt",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 2,
     "strophe": "s1",
     "texte": "De femme à cheveux bruns fortement pommadés",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 3,
     "strophe": "s1",
     "texte": "D'une vieille baignoire émerge, lente et bête,",
     "rime": "êt",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 4,
     "strophe": "s1",
     "texte": "Avec des déficits assez mal ravaudés ;",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 5,
     "strophe": "s2",
     "texte": "Puis le col gras et gris, les larges omoplates",
     "rime": "at",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 6,
     "strophe": "s2",
     "texte": "Qui saillent ; le dos court qui rentre et qui ressort ;",
     "rime": "ort",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 7,
     "strophe": "s2",
     "texte": "Puis les rondeurs des reins semblent prendre l'essor ;",
     "rime": "or",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 8,
     "strophe": "s2",
     "texte": "La graisse sous la peau paraît en feuilles plates ;",
     "rime": "at",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 9,
     "strophe": "s3",
     "texte": "L'échine est un peu rouge, et le tout sent un goût",
     "rime": "oût",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 10,
     "strophe": "s3",
     "texte": "Horrible étrangement ; on remarque surtout",
     "rime": "out",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 11,
     "strophe": "s3",
     "texte": "Des singularités qu'il faut voir à la loupe…",
     "rime": "oup",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 12,
     "strophe": "s4",
     "texte": "Les reins portent deux mots gravés : Clara Venus ;",
     "rime": "u",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 13,
     "strophe": "s4",
     "texte": "— Et tout ce corps remue et tend sa large croupe",
     "rime": "oup",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    },
    {
     "n": 14,
     "strophe": "s4",
     "texte": "Belle hideusement d'un ulcère à l'anus.",
     "rime": "u",
     "procede": "",
     "effet": "",
     "champs": [
      "corps"
     ]
    }
   ]
  }
 ]
}