      "lignes": [
        {
          "n": 1,
          "strophe": "s1",
          "texte": "Lui — Ta poitrine sur ma poitrine,",
          "rime": "in",
          "procede": "Didascalie « Lui » / écho « poitrine sur ma poitrine »",
          "effet": "Ouverture intime : l'étreinte annoncée du couple.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 2,
          "strophe": "s1",
          "texte": "Hein ? nous irions,",
          "rime": "ion",
          "procede": "Interjection orale « Hein ? »",
          "effet": "Ton de confidence, complicité du dialogue amoureux.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 3,
          "strophe": "s1",
          "texte": "Ayant de l'air plein la narine,",
          "rime": "in",
          "procede": "Image de l'air respiré « de l'air plein la narine »",
          "effet": "Volupté de respirer à pleins poumons.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 4,
          "strophe": "s1",
          "texte": "Aux frais rayons",
          "rime": "on",
          "procede": "Alliance fraîcheur / lumière « frais rayons »",
          "effet": "Fraîcheur lumineuse du matin.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 5,
          "strophe": "s2",
          "texte": "Du bon matin bleu, qui vous baigne",
          "rime": "aign",
          "procede": "Chromaticisme du « matin bleu »",
          "effet": "Le matin, couleur et bain.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 6,
          "strophe": "s2",
          "texte": "Du vin de jour ?…",
          "rime": "our",
          "procede": "Métaphore du « vin de jour »",
          "effet": "L'ivresse naturelle de l'aube.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 7,
          "strophe": "s2",
          "texte": "Quand tout le bois frissonnant saigne",
          "rime": "aign",
          "procede": "Personnification du bois « frissonnant saigne »",
          "effet": "Le bois, corps vivant et souffrant.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 8,
          "strophe": "s2",
          "texte": "Muet d'amour",
          "rime": "our",
          "procede": "Association amour / silence « muet d'amour »",
          "effet": "Le silence même devient amoureux.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 9,
          "strophe": "s3",
          "texte": "De chaque branche, gouttes vertes,",
          "rime": "ert",
          "procede": "Image des « gouttes vertes »",
          "effet": "La sève perle aux branches.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 10,
          "strophe": "s3",
          "texte": "Des bourgeons clairs,",
          "rime": "air",
          "procede": "Chromaticisme « bourgeons clairs »",
          "effet": "Éclat tendre du printemps.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 11,
          "strophe": "s3",
          "texte": "On sent dans les choses ouvertes",
          "rime": "ert",
          "procede": "Épanchement sensoriel « choses ouvertes »",
          "effet": "Le monde s'ouvre aux sens des amants.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 12,
          "strophe": "s3",
          "texte": "Frémir des chairs :",
          "rime": "air",
          "procede": "Image charnelle « frémir des chairs »",
          "effet": "La nature entière frémit comme un corps.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 13,
          "strophe": "s4",
          "texte": "Tu plongerais dans la luzerne",
          "rime": "ern",
          "procede": "Verbe d'immersion « plongerais »",
          "effet": "Immersion de l'amoureuse dans l'herbe.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 14,
          "strophe": "s4",
          "texte": "Ton blanc peignoir,",
          "rime": "oir",
          "procede": "Antithèse blanc / vert « blanc peignoir / luzerne »",
          "effet": "Le linge blanc dans l'herbe verte.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 15,
          "strophe": "s4",
          "texte": "Rosant à l'air ce bleu qui cerne",
          "rime": "ern",
          "procede": "Image du bleu cerclant l'œil",
          "effet": "Le regard, auréolé d'air frais.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 16,
          "strophe": "s4",
          "texte": "Ton grand œil noir,",
          "rime": "oir",
          "procede": "Détail physique « grand œil noir »",
          "effet": "Le regard sombre, point focal du visage.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 17,
          "strophe": "s5",
          "texte": "Amoureuse de la campagne,",
          "rime": "agn",
          "procede": "Personnification amoureuse « amoureuse de la campagne »",
          "effet": "L'héroïne, éprise de la nature.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 18,
          "strophe": "s5",
          "texte": "Semant partout,",
          "rime": "out",
          "procede": "Geste du semis « semant partout »",
          "effet": "Elle répand sa joie autour d'elle.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 19,
          "strophe": "s5",
          "texte": "Comme une mousse de Champagne,",
          "rime": "agn",
          "procede": "Comparaison « mousse de Champagne »",
          "effet": "Le rire, mousse légère et pétillante.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 20,
          "strophe": "s5",
          "texte": "Ton rire fou :",
          "rime": "ou",
          "procede": "Épithète « rire fou »",
          "effet": "Rire libéré, insouciant.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 21,
          "strophe": "s6",
          "texte": "Riant à moi, brutal d'ivresse,",
          "rime": "ess",
          "procede": "Lexique de l'ivresse « brutal d'ivresse »",
          "effet": "Étreinte joyeuse et sauvage.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 22,
          "strophe": "s6",
          "texte": "Qui te prendrais.",
          "rime": "ai",
          "procede": "Verbe possessif « te prendrais »",
          "effet": "L'homme, amant dominateur et tendre.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 23,
          "strophe": "s6",
          "texte": "Comme cela, — la belle tresse,",
          "rime": "ess",
          "procede": "Didascalie orale « Comme cela »",
          "effet": "Détail physique, tendresse gouailleuse.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 24,
          "strophe": "s6",
          "texte": "Oh ! — qui boirais",
          "rime": "ai",
          "procede": "Exclamation « Oh ! »",
          "effet": "Fruition sensuelle annoncée.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 25,
          "strophe": "s7",
          "texte": "Ton goût de framboise et de fraise,",
          "rime": "ais",
          "procede": "Image gustative « framboise et fraise »",
          "effet": "Le baiser, saveur de fruits.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 26,
          "strophe": "s7",
          "texte": "Ô chair de fleur !",
          "rime": "eur",
          "procede": "Apostrophe « chair de fleur »",
          "effet": "La bien-aimée, fleur incarnée.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 27,
          "strophe": "s7",
          "texte": "Riant au vent vif qui te baise",
          "rime": "ais",
          "procede": "Personnification du vent « qui te baise »",
          "effet": "Le vent, amant naturel.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 28,
          "strophe": "s7",
          "texte": "Comme un voleur,",
          "rime": "eur",
          "procede": "Comparaison « comme un voleur »",
          "effet": "Le vent, caresse furtive.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 29,
          "strophe": "s8",
          "texte": "Au rose églantier qui t'embête",
          "rime": "êt",
          "procede": "Personnification de l'églantier « qui t'embête »",
          "effet": "La nature, complice ou taquine.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 30,
          "strophe": "s8",
          "texte": "Aimablement :",
          "rime": "ent",
          "procede": "Contradiction feinte « embête / aimablement »",
          "effet": "La contrariété, douceur du jeu amoureux.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 31,
          "strophe": "s8",
          "texte": "Riant surtout, ô folle tête,",
          "rime": "êt",
          "procede": "Apostrophe affectueuse « folle tête »",
          "effet": "Tendre moquerie de l'amant.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 32,
          "strophe": "s8",
          "texte": "À ton amant !…",
          "rime": "ant",
          "procede": "Révélation « À ton amant !… »",
          "effet": "Le rire, lien des deux amants.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 33,
          "strophe": "s9",
          "texte": "Ta poitrine sur ma poitrine,",
          "rime": "in",
          "procede": "Reprise en écho du v. 1 « Ta poitrine sur ma poitrine »",
          "effet": "Le rêve reprend et se poursuit.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 34,
          "strophe": "s9",
          "texte": "Mêlant nos voix,",
          "rime": "oix",
          "procede": "Image du mélange « mêlant nos voix »",
          "effet": "Harmonie vocale du couple.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 35,
          "strophe": "s9",
          "texte": "Lents, nous gagnerions la ravine,",
          "rime": "in",
          "procede": "Rythme lent « Lents »",
          "effet": "Marche paresseuse, à deux.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 36,
          "strophe": "s9",
          "texte": "Puis les grands bois !…",
          "rime": "oi",
          "procede": "Exclamation « les grands bois !… »",
          "effet": "Le bois, destination amoureuse.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 37,
          "strophe": "s10",
          "texte": "Puis, comme une petite morte,",
          "rime": "ort",
          "procede": "Comparaison « comme une petite morte »",
          "effet": "Extase, pâmoison amoureuse.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 38,
          "strophe": "s10",
          "texte": "Le cœur pâmé,",
          "rime": "é",
          "procede": "État de pâmoison « cœur pâmé »",
          "effet": "Évanouissement délicieux.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 39,
          "strophe": "s10",
          "texte": "Tu me dirais que je te porte,",
          "rime": "ort",
          "procede": "Confidence murmurée « que je te porte »",
          "effet": "Tendresse de l'étreinte portée.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 40,
          "strophe": "s10",
          "texte": "L'œil mi-fermé…",
          "rime": "é",
          "procede": "Image de la paupière « l'œil mi-fermé »",
          "effet": "Demi-sommeil voluptueux.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 41,
          "strophe": "s11",
          "texte": "Je te porterais, palpitante,",
          "rime": "ant",
          "procede": "Écho du v. 39 « Je te porterais »",
          "effet": "Réciprocité de l'étreinte.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 42,
          "strophe": "s11",
          "texte": "Dans le sentier :",
          "rime": "ier",
          "procede": "Cadre rustique « dans le sentier »",
          "effet": "Le chemin, scène du couple.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 43,
          "strophe": "s11",
          "texte": "L'oiseau filerait son andante :",
          "rime": "ant",
          "procede": "Personnification musicale « l'oiseau filerait son andante »",
          "effet": "Le chant d'oiseau, tempo amoureux.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 44,
          "strophe": "s11",
          "texte": "Au Noisetier…",
          "rime": "ier",
          "procede": "Point d'orgue du lieu « Au Noisetier »",
          "effet": "Le noisetier, repère de la promenade.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 45,
          "strophe": "s12",
          "texte": "Je te parlerais dans ta bouche :",
          "rime": "ouch",
          "procede": "Image du « parler dans ta bouche »",
          "effet": "Le baiser, parole muette.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 46,
          "strophe": "s12",
          "texte": "J'irais, pressant",
          "rime": "ant",
          "procede": "Mouvement pressant « pressant »",
          "effet": "Étreinte empressée.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 47,
          "strophe": "s12",
          "texte": "Ton corps, comme une enfant qu'on couche,",
          "rime": "ouch",
          "procede": "Comparaison « comme une enfant qu'on couche »",
          "effet": "Tendresse paternelle et amoureuse.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 48,
          "strophe": "s12",
          "texte": "Ivre du sang",
          "rime": "ang",
          "procede": "Ivresse du sang « ivre du sang »",
          "effet": "Sensibilité à fleur de peau.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 49,
          "strophe": "s13",
          "texte": "Qui coule, bleu, sous ta peau blanche",
          "rime": "anch",
          "procede": "Antithèse bleu / blanc « sang bleu / peau blanche »",
          "effet": "Le réseau veineux, dessin sous la peau.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 50,
          "strophe": "s13",
          "texte": "Aux tons rosés :",
          "rime": "é",
          "procede": "Chromaticisme « tons rosés »",
          "effet": "Teint de l'amoureuse.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 51,
          "strophe": "s13",
          "texte": "Et te parlant la langue franche…",
          "rime": "anch",
          "procede": "Expression idiomatique « langue franche »",
          "effet": "Parler vrai du couple.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 52,
          "strophe": "s13",
          "texte": "Tiens !… — que tu sais…",
          "rime": "ai",
          "procede": "Didascalie orale « Tiens !… »",
          "effet": "Complicité du langage privé.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 53,
          "strophe": "s14",
          "texte": "Nos grands bois sentiraient la sève",
          "rime": "èv",
          "procede": "Personnification de la sève odorante",
          "effet": "Le bois, parfum de vie.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 54,
          "strophe": "s14",
          "texte": "Et le soleil",
          "rime": "eil",
          "procede": "Ellipse du sujet « et le soleil »",
          "effet": "Le soleil, acteur du décor.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 55,
          "strophe": "s14",
          "texte": "Sablerait d'or fin leur grand rêve",
          "rime": "êv",
          "procede": "Métaphore du « sablage d'or »",
          "effet": "Le soleil, doreur du rêve.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 56,
          "strophe": "s14",
          "texte": "Vert et vermeil.",
          "rime": "eil",
          "procede": "Chromaticisme « vert et vermeil »",
          "effet": "Vert de la sève, rose de l'aube.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 57,
          "strophe": "s15",
          "texte": "Le soir ?… Nous reprendrons la route",
          "rime": "out",
          "procede": "Question rhétorique « Le soir ?… »",
          "effet": "Le soir, retour du chemin.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 58,
          "strophe": "s15",
          "texte": "Blanche qui court",
          "rime": "ourt",
          "procede": "Image de la route « blanche qui court »",
          "effet": "Le chemin, ruban lumineux.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 59,
          "strophe": "s15",
          "texte": "Flânant, comme un troupeau qui broute,",
          "rime": "out",
          "procede": "Comparaison « comme un troupeau qui broute »",
          "effet": "Allure lente et grégaire.",
          "champs": [
            "amour"
          ]
        },
        {
          "n": 60,
          "strophe": "s15",
          "texte": "Tout à l'entour",
          "rime": "our",
          "procede": "Circularité « tout à l'entour »",
          "effet": "Le couple au centre du paysage.",
