     "procede": "",
     "effet": "",
     "champs": [
      "satire"
     ]
    },
    {
     "n": 27,
     "strophe": "s7",
     "texte": "Elles le savent bien, et tournent en riant,",
     "rime": "iant",
     "procede": "",
     "effet": "",
     "champs": [
      "satire"
     ]
    },
    {
     "n": 28,
     "strophe": "s7",
     "texte": "Vers moi, leurs yeux tout pleins de choses indiscrètes.",
