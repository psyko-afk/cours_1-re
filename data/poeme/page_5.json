     "procede": "",
     "effet": "",
     "champs": [
      "satire"
     ]
    },
    {
     "n": 4,
     "strophe": "s1",
     "texte": "Portent, les jeudis soirs, leurs bêtises jalouses.",
     "rime": "ous",
     "procede": "",
     "effet": "",
     "champs": [
      "satire"
     ]
    },
    {
     "n": 5,
     "strophe": "s2",
     "texte": "— L'orchestre militaire, au milieu du jardin,",
