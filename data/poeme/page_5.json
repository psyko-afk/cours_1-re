   ],
   "lignes": [
    {
     "n": 1,
     "strophe": "s1",
     "texte": "Lui — Ta poitrine sur ma poitrine,",
     "rime": "in",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 2,
     "strophe": "s1",
     "texte": "Hein ? nous irions,",
     "rime": "ion",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 3,
     "strophe": "s1",
     "texte": "Ayant de l'air plein la narine,",
     "rime": "in",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 4,
     "strophe": "s1",
     "texte": "Aux frais rayons",
     "rime": "on",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 5,
     "strophe": "s2",
     "texte": "Du bon matin bleu, qui vous baigne",
     "rime": "aign",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 6,
     "strophe": "s2",
     "texte": "Du vin de jour ?…",
     "rime": "our",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 7,
     "strophe": "s2",
     "texte": "Quand tout le bois frissonnant saigne",
     "rime": "aign",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 8,
     "strophe": "s2",
     "texte": "Muet d'amour",
     "rime": "our",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 9,
     "strophe": "s3",
     "texte": "De chaque branche, gouttes vertes,",
     "rime": "ert",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 10,
     "strophe": "s3",
     "texte": "Des bourgeons clairs,",
     "rime": "air",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 11,
     "strophe": "s3",
     "texte": "On sent dans les choses ouvertes",
     "rime": "ert",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 12,
     "strophe": "s3",
     "texte": "Frémir des chairs :",
     "rime": "air",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 13,
     "strophe": "s4",
     "texte": "Tu plongerais dans la luzerne",
     "rime": "ern",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 14,
     "strophe": "s4",
     "texte": "Ton blanc peignoir,",
     "rime": "oir",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 15,
     "strophe": "s4",
     "texte": "Rosant à l'air ce bleu qui cerne",
     "rime": "ern",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 16,
     "strophe": "s4",
     "texte": "Ton grand œil noir,",
     "rime": "oir",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 17,
     "strophe": "s5",
     "texte": "Amoureuse de la campagne,",
     "rime": "agn",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 18,
     "strophe": "s5",
     "texte": "Semant partout,",
     "rime": "out",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 19,
     "strophe": "s5",
     "texte": "Comme une mousse de Champagne,",
     "rime": "agn",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 20,
     "strophe": "s5",
     "texte": "Ton rire fou :",
     "rime": "ou",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 21,
     "strophe": "s6",
     "texte": "Riant à moi, brutal d'ivresse,",
     "rime": "ess",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 22,
     "strophe": "s6",
     "texte": "Qui te prendrais.",
     "rime": "ai",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 23,
     "strophe": "s6",
     "texte": "Comme cela, — la belle tresse,",
     "rime": "ess",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 24,
     "strophe": "s6",
     "texte": "Oh ! — qui boirais",
     "rime": "ai",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 25,
     "strophe": "s7",
     "texte": "Ton goût de framboise et de fraise,",
     "rime": "ais",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 26,
     "strophe": "s7",
     "texte": "Ô chair de fleur !",
     "rime": "eur",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 27,
     "strophe": "s7",
     "texte": "Riant au vent vif qui te baise",
     "rime": "ais",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 28,
     "strophe": "s7",
     "texte": "Comme un voleur,",
     "rime": "eur",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 29,
     "strophe": "s8",
     "texte": "Au rose églantier qui t'embête",
     "rime": "êt",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 30,
     "strophe": "s8",
     "texte": "Aimablement :",
     "rime": "ent",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 31,
     "strophe": "s8",
     "texte": "Riant surtout, ô folle tête,",
     "rime": "êt",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 32,
     "strophe": "s8",
     "texte": "À ton amant !…",
     "rime": "ant",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 33,
     "strophe": "s9",
     "texte": "Ta poitrine sur ma poitrine,",
     "rime": "in",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 34,
     "strophe": "s9",
     "texte": "Mêlant nos voix,",
     "rime": "oix",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 35,
     "strophe": "s9",
     "texte": "Lents, nous gagnerions la ravine,",
     "rime": "in",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 36,
     "strophe": "s9",
     "texte": "Puis les grands bois !…",
     "rime": "oi",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 37,
     "strophe": "s10",
     "texte": "Puis, comme une petite morte,",
     "rime": "ort",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 38,
     "strophe": "s10",
     "texte": "Le cœur pâmé,",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 39,
     "strophe": "s10",
     "texte": "Tu me dirais que je te porte,",
     "rime": "ort",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 40,
     "strophe": "s10",
     "texte": "L'œil mi-fermé…",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 41,
     "strophe": "s11",
     "texte": "Je te porterais, palpitante,",
     "rime": "ant",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 42,
     "strophe": "s11",
     "texte": "Dans le sentier :",
     "rime": "ier",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 43,
     "strophe": "s11",
     "texte": "L'oiseau filerait son andante :",
     "rime": "ant",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 44,
     "strophe": "s11",
     "texte": "Au Noisetier…",
     "rime": "ier",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 45,
     "strophe": "s12",
     "texte": "Je te parlerais dans ta bouche :",
     "rime": "ouch",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 46,
     "strophe": "s12",
     "texte": "J'irais, pressant",
     "rime": "ant",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 47,
     "strophe": "s12",
     "texte": "Ton corps, comme une enfant qu'on couche,",
     "rime": "ouch",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 48,
     "strophe": "s12",
     "texte": "Ivre du sang",
     "rime": "ang",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 49,
     "strophe": "s13",
     "texte": "Qui coule, bleu, sous ta peau blanche",
     "rime": "anch",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 50,
     "strophe": "s13",
     "texte": "Aux tons rosés :",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 51,
     "strophe": "s13",
     "texte": "Et te parlant la langue franche…",
     "rime": "anch",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 52,
     "strophe": "s13",
     "texte": "Tiens !… — que tu sais…",
     "rime": "ai",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 53,
     "strophe": "s14",
     "texte": "Nos grands bois sentiraient la sève",
     "rime": "èv",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 54,
     "strophe": "s14",
     "texte": "Et le soleil",
     "rime": "eil",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 55,
     "strophe": "s14",
     "texte": "Sablerait d'or fin leur grand rêve",
     "rime": "êv",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 56,
     "strophe": "s14",
     "texte": "Vert et vermeil.",
     "rime": "eil",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 57,
     "strophe": "s15",
     "texte": "Le soir ?… Nous reprendrons la route",
     "rime": "out",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 58,
     "strophe": "s15",
     "texte": "Blanche qui court",
     "rime": "ourt",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 59,
     "strophe": "s15",
     "texte": "Flânant, comme un troupeau qui broute,",
     "rime": "out",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 60,
     "strophe": "s15",
     "texte": "Tout à l'entour",
     "rime": "our",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 61,
     "strophe": "s16",
     "texte": "Les bons vergers à l'herbe bleue",
     "rime": "eue",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 62,
     "strophe": "s16",
     "texte": "Aux pommiers tors !",
     "rime": "or",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 63,
     "strophe": "s16",
     "texte": "Comme on les sent toute une lieue",
     "rime": "ieue",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 64,
     "strophe": "s16",
     "texte": "Leurs parfums forts !",
     "rime": "ort",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 65,
     "strophe": "s17",
     "texte": "Nous regagnerons le village",
     "rime": "ag",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 66,
     "strophe": "s17",
     "texte": "Au ciel mi-noir ;",
     "rime": "oir",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 67,
     "strophe": "s17",
     "texte": "Et ça sentira le laitage",
     "rime": "ag",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 68,
     "strophe": "s17",
     "texte": "Dans l'air du soir ;",
     "rime": "oir",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 69,
     "strophe": "s18",
     "texte": "Ça sentira l'étable, pleine",
     "rime": "ein",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 70,
     "strophe": "s18",
     "texte": "De fumiers chauds,",
     "rime": "aud",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 71,
     "strophe": "s18",
     "texte": "Pleine d'un lent rythme d'haleine,",
     "rime": "ein",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 72,
     "strophe": "s18",
     "texte": "Et de grands dos",
     "rime": "o",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 73,
     "strophe": "s19",
     "texte": "Blanchissant sous quelque lumière ;",
     "rime": "ièr",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 74,
     "strophe": "s19",
     "texte": "Et, tout là-bas,",
     "rime": "a",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 75,
     "strophe": "s19",
     "texte": "Une vache fientera, fière,",
     "rime": "ièr",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 76,
     "strophe": "s19",
     "texte": "À chaque pas…",
     "rime": "a",
     "procede": "",
     "effet": "",
     "champs": [
      "amour"
     ]
    },
    {
     "n": 77,
