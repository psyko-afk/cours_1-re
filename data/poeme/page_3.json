          "vers": "Quatrain - Alexandrins"
        },
        {
          "id": "s9",
          "nom": "Strophe 9",
          "vers": "Quatrain - Alexandrins"
        }
      ],
      "lignes": [
        {
          "n": 1,
          "strophe": "s1",
          "texte": "Sur l'onde calme et noire où dorment les étoiles",
          "rime": "s",
          "procede": "Allitérations en -l",
          "effet": "Douceur mélancolique de l'eau.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 2,
          "strophe": "s1",
          "texte": "La blanche Ophélia flotte comme un grand lys,",
          "rime": "",
          "procede": "Comparaison au lys",
          "effet": "Pureté de la morte, fleur blanche.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 3,
          "strophe": "s1",
          "texte": "Flotte très lentement, couchée en ses longs voiles…",
          "rime": "oil",
          "procede": "Rythme lent « très lentement »",
          "effet": "Dérive funèbre, lenteur hypnotique.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 4,
          "strophe": "s1",
          "texte": "— On entend dans les bois lointains des hallalis.",
          "rime": "i",
          "procede": "Son lointain « hallalis »",
          "effet": "Bruits de chasse, écho tragique.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 5,
          "strophe": "s2",
          "texte": "Voici plus de mille ans que la triste Ophélie",
          "rime": "ie",
          "procede": "Hyperbole temporelle « plus de mille ans »",
          "effet": "Mythification du personnage.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 6,
          "strophe": "s2",
          "texte": "Passe, fantôme blanc, sur le long fleuve noir ;",
          "rime": "oir",
          "procede": "Antithèse « fantôme blanc / fleuve noir »",
          "effet": "Fantôme lumineux sur l'eau sombre.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 7,
          "strophe": "s2",
          "texte": "Voici plus de mille ans que sa douce folie",
          "rime": "ie",
          "procede": "Reprise « Voici plus de mille ans »",
          "effet": "Refrain du mythe, incantation.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 8,
          "strophe": "s2",
          "texte": "Murmure sa romance à la brise du soir.",
          "rime": "oir",
          "procede": "Personnification du murmure « murmure sa romance »",
          "effet": "Chant éternel, porté par la brise.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 9,
          "strophe": "s3",
          "texte": "Le vent baise ses seins et déploie en corolle",
          "rime": "oll",
          "procede": "Personnification érotique du vent « baise ses seins »",
          "effet": "La nature, amant attentif.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 10,
          "strophe": "s3",
          "texte": "Ses grands voiles bercés mollement par les eaux ;",
          "rime": "eaux",
          "procede": "Berceuse aquatique « bercés mollement »",
          "effet": "L'eau, mère et tombeau.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 11,
          "strophe": "s3",
          "texte": "Les saules frissonnants pleurent sur son épaule,",
          "rime": "aul",
          "procede": "Personnification des saules « pleurent »",
          "effet": "La nature, pleureuse officielle.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 12,
          "strophe": "s3",
          "texte": "Sur son grand front rêveur s'inclinent les roseaux.",
          "rime": "eaux",
          "procede": "Personnification des roseaux « s'inclinent »",
          "effet": "Hommage végétal à la morte.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 13,
          "strophe": "s4",
          "texte": "Les nénuphars froissés soupirent autour d'elle ;",
          "rime": "ell",
          "procede": "Personnification des nénuphars « soupirent »",
          "effet": "La flore, communauté en deuil.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 14,
          "strophe": "s4",
          "texte": "Elle éveille parfois, dans un aune qui dort,",
          "rime": "ort",
          "procede": "Personnification de l'aune « qui dort »",
          "effet": "La morte réveille la nature endormie.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 15,
          "strophe": "s4",
          "texte": "Quelque nid, d'où s'échappe un petit frisson d'aile :",
          "rime": "ail",
          "procede": "Image du « frisson d'aile »",
          "effet": "Vie timide, frémissante autour de la morte.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 16,
          "strophe": "s4",
          "texte": "— Un chant mystérieux tombe des astres d'or.",
          "rime": "or",
          "procede": "Hyperbole céleste « chant des astres d'or »",
          "effet": "Le ciel, témoin chantant.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 17,
          "strophe": "s5",
          "texte": "Ô pâle Ophélia ! belle comme la neige !",
          "rime": "eig",
          "procede": "Apostrophe / comparaison « belle comme la neige »",
          "effet": "Pureté glacée de l'héroïne.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 18,
          "strophe": "s5",
          "texte": "Oui tu mourus, enfant, par un fleuve emporté !",
          "rime": "é",
          "procede": "Tutoiement direct « tu mourus, enfant »",
          "effet": "Compassion du poète pour l'enfant morte.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 19,
          "strophe": "s5",
          "texte": "— C'est que les vents tombant des grands monts de Norwège",
          "rime": "èg",
          "procede": "Anaphore « C'est que »",
          "effet": "Énumération des causes du destin.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 20,
          "strophe": "s5",
          "texte": "T'avaient parlé tout bas de l'âpre liberté ;",
          "rime": "é",
          "procede": "Épithète « âpre »",
          "effet": "Liberté amère, appât fatal.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 21,
          "strophe": "s6",
          "texte": "C'est qu'un souffle, tordant ta grande chevelure,",
          "rime": "ur",
          "procede": "Image du souffle « tordant ta grande chevelure »",
          "effet": "Le vent, créateur de tourments.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 22,
          "strophe": "s6",
          "texte": "À ton esprit rêveur portait d'étranges bruits ;",
          "rime": "uit",
          "procede": "Mystère sonore « d'étranges bruits »",
          "effet": "Appels d'ailleurs, vertige.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 23,
          "strophe": "s6",
          "texte": "Que ton cœur écoutait le chant de la Nature",
          "rime": "ur",
          "procede": "Personnification « chant de la Nature »",
          "effet": "Harmonie initiatique, voix maternelle.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 24,
          "strophe": "s6",
          "texte": "Dans les plaintes de l'arbre et les soupirs des nuits ;",
          "rime": "uit",
          "procede": "Personnification plaintive « plaintes / soupirs »",
          "effet": "Nature éplorée, écho du chagrin.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 25,
          "strophe": "s7",
          "texte": "C'est que la voix des mers folles, immense râle,",
          "rime": "âl",
          "procede": "Hyperbole « immense râle »",
          "effet": "La mer, monstre gémissant.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 26,
          "strophe": "s7",
          "texte": "Brisait ton sein d'enfant, trop humain et trop doux ;",
          "rime": "oux",
          "procede": "Antithèse tendresse / violence",
          "effet": "Tendresse condamnée par le monde.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 27,
          "strophe": "s7",
          "texte": "C'est qu'un matin d'avril, un beau cavalier pâle,",
          "rime": "âl",
          "procede": "Ironie « un beau cavalier pâle »",
          "effet": "L'épisode d'Hamlet, la mort du père.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 28,
          "strophe": "s7",
          "texte": "Un pauvre fou, s'assit muet à tes genoux !",
          "rime": "oux",
          "procede": "Portrait du fou d'Hamlet, muet",
          "effet": "Le fou d'Hamlet, silencieux, glaçant.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 29,
          "strophe": "s8",
          "texte": "Ciel ! Amour ! Liberté ! Quel rêve, ô pauvre Folle !",
          "rime": "oll",
          "procede": "Exclamation trinitaire « Ciel ! Amour ! Liberté ! »",
          "effet": "Les trois aspirations brisées.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 30,
          "strophe": "s8",
          "texte": "Tu te fondais à lui comme une neige au feu :",
          "rime": "eu",
          "procede": "Comparaison « comme une neige au feu »",
          "effet": "Amour impossible, fusion mortelle.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 31,
          "strophe": "s8",
          "texte": "Tes grandes visions étranglaient ta parole",
          "rime": "ol",
          "procede": "Image de l'étranglement « visions étranglaient »",
          "effet": "Le rêve étouffe la voix.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 32,
          "strophe": "s8",
          "texte": "— Et l'Infini terrible effara ton œil bleu !",
          "rime": "eu",
          "procede": "Épithète « terrible »",
          "effet": "Vertige métaphysique, effroi du sublime.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 33,
          "strophe": "s9",
          "texte": "— Et le Poète dit qu'aux rayons des étoiles",
          "rime": "oil",
          "procede": "Prosopopée du « Poète »",
          "effet": "Le mythe se fait légende littéraire.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 34,
          "strophe": "s9",
          "texte": "Tu viens chercher, la nuit, les fleurs que tu cueillis,",
          "rime": "i",
          "procede": "Image nocturne « aux rayons des étoiles »",
          "effet": "Retour fantomatique des fleurs cueillies.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 35,
          "strophe": "s9",
          "texte": "Et qu'il a vu sur l'eau, couchée en ses longs voiles,",
          "rime": "oil",
          "procede": "Reprise en écho du v. 3",
          "effet": "Boucle du poème, récit légendaire.",
          "champs": [
            "mort"
          ]
        },
        {
          "n": 36,
          "strophe": "s9",
          "texte": "La blanche Ophélia flotter, comme un grand lys.",
          "rime": "",
          "procede": "Reprise du v. 2",
          "effet": "Le lys, emblème final de la pureté.",
          "champs": [
            "mort"
          ]
        }
      ]
    },
    {
      "id": "bal_des_pendus",
      "titre": "Bal des pendus",
      "date": "1870",
      "auteur": "Arthur Rimbaud",
      "recueil": "Cahiers de Douai",
      "contexte": [
        "Poème macabre et grotesque, inspiré d'une danse macabre médiévale.",
        "Mise en scène de squelettes qui dansent dans le vent."
      ],
      "forme": [
        "Quatrains en octosyllabes.",
        "Ton satirique et macabre."
      ],
      "champs": {
