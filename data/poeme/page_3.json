    },
    {
     "id": "s3",
     "nom": "Strophe 3",
     "vers": "Quatrain - Octosyllabes"
    },
    {
     "id": "s4",
     "nom": "Strophe 4",
     "vers": "Quatrain - Octosyllabes"
    },
    {
     "id": "s5",
     "nom": "Strophe 5",
     "vers": "Quatrain - Octosyllabes"
    },
    {
     "id": "s6",
     "nom": "Strophe 6",
     "vers": "Quatrain - Octosyllabes"
    },
    {
     "id": "s7",
     "nom": "Strophe 7",
     "vers": "Quatrain - Octosyllabes"
    },
    {
     "id": "s8",
     "nom": "Strophe 8",
     "vers": "Quatrain - Octosyllabes"
    },
    {
     "id": "s9",
     "nom": "Strophe 9",
     "vers": "Quatrain - Octosyllabes"
    },
    {
     "id": "s10",
     "nom": "Strophe 10",
     "vers": "Quatrain - Octosyllabes"
    },
    {
     "id": "s11",
     "nom": "Strophe 11",
     "vers": "Quatrain - Octosyllabes"
    }
   ],
   "lignes": [
    {
     "n": 1,
     "strophe": "s1",
     "texte": "Au gibet noir, manchot aimable,",
     "rime": "abl",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 2,
     "strophe": "s1",
     "texte": "Dansent, dansent les paladins,",
     "rime": "in",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 3,
     "strophe": "s1",
     "texte": "Les maigres paladins du diable.",
     "rime": "iabl",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 4,
     "strophe": "s1",
     "texte": "Les squelettes de Saladins.",
     "rime": "in",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 5,
     "strophe": "s2",
     "texte": "Messire Belzébuth tire par la cravate",
     "rime": "at",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 6,
     "strophe": "s2",
     "texte": "Ses petits pantins noirs grimaçant sur le ciel,",
     "rime": "iel",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 7,
     "strophe": "s2",
     "texte": "Et, leur claquant au front un revers de savate,",
     "rime": "at",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 8,
     "strophe": "s2",
     "texte": "Les fait danser, danser aux sons d'un vieux Noël !",
     "rime": "oël",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 9,
     "strophe": "s3",
     "texte": "Et les pantins choqués enlacent leurs bras grêles :",
     "rime": "êl",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 10,
     "strophe": "s3",
     "texte": "Comme des orgues noirs, les poitrines à jour",
     "rime": "our",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 11,
     "strophe": "s3",
     "texte": "Que serraient autrefois les gentes damoiselles,",
     "rime": "ell",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 12,
     "strophe": "s3",
     "texte": "Se heurtent longuement dans un hideux amour.",
     "rime": "our",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 13,
     "strophe": "s4",
     "texte": "Hurrah ! Les gais danseurs, qui n'avez plus de panse !",
     "rime": "ans",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 14,
     "strophe": "s4",
     "texte": "On peut cabrioler, les tréteaux sont si longs !",
     "rime": "ong",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 15,
     "strophe": "s4",
     "texte": "Hop ! qu'on ne sache plus si c'est bataille ou danse !",
     "rime": "ans",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 16,
     "strophe": "s4",
     "texte": "Belzébuth enragé racle ses violons !",
     "rime": "on",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 17,
     "strophe": "s5",
     "texte": "Ô durs talons, jamais on n'use sa sandale !",
     "rime": "al",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 18,
     "strophe": "s5",
     "texte": "Presque tous ont quitté la chemise de peau :",
     "rime": "eau",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 19,
     "strophe": "s5",
     "texte": "Le reste est peu gênant et se voit sans scandale.",
     "rime": "al",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 20,
     "strophe": "s5",
     "texte": "Sur les crânes, la neige applique un blanc chapeau :",
     "rime": "eau",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 21,
     "strophe": "s6",
     "texte": "Le corbeau fait panache à ces têtes fêlées,",
     "rime": "ée",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 22,
     "strophe": "s6",
     "texte": "Un morceau de chair tremble à leur maigre menton :",
     "rime": "on",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 23,
     "strophe": "s6",
     "texte": "On dirait, tournoyant dans les sombres mêlées,",
     "rime": "ée",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 24,
     "strophe": "s6",
     "texte": "Des preux, raides, heurtant armures de carton.",
     "rime": "on",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 25,
     "strophe": "s7",
     "texte": "Hurrah ! La bise siffle au grand bal des squelettes !",
     "rime": "ett",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 26,
     "strophe": "s7",
     "texte": "Le gibet noir mugit comme un orgue de fer !",
     "rime": "er",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 27,
     "strophe": "s7",
     "texte": "Les loups vont répondant des forêts violettes :",
     "rime": "ett",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 28,
     "strophe": "s7",
     "texte": "À l'horizon, le ciel est d'un rouge d'enfer…",
     "rime": "er",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 29,
     "strophe": "s8",
     "texte": "Holà, secouez-moi ces capitans funèbres",
     "rime": "èbr",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 30,
     "strophe": "s8",
     "texte": "Qui défilent, sournois, de leurs gros doigts cassés",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 31,
     "strophe": "s8",
     "texte": "Un chapelet d'amour sur leurs pâles vertèbres :",
     "rime": "èbr",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 32,
     "strophe": "s8",
     "texte": "Ce n'est pas un moustier ici, les trépassés !",
     "rime": "é",
     "procede": "",
     "effet": "",
     "champs": [
      "macabre"
     ]
    },
    {
     "n": 33,
     "strophe": "s9",
     "texte": "Oh ! voilà qu'au miheu de la danse macabre",
