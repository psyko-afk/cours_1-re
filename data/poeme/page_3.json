        },
        {
          "id": "s3",
          "nom": "Strophe 3",
          "vers": "Quatrain - Alexandrins"
        },
        {
          "id": "s4",
          "nom": "Strophe 4",
          "vers": "Quatrain - Alexandrins"
        },
        {
          "id": "s5",
          "nom": "Strophe 5",
          "vers": "Quatrain - Alexandrins"
        },
        {
          "id": "s6",
          "nom": "Strophe 6",
          "vers": "Quatrain - Alexandrins"
        },
        {
          "id": "s7",
          "nom": "Strophe 7",
          "vers": "Quatrain - Alexandrins"
        },
        {
          "id": "s8",
