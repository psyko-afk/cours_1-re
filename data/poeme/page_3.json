        },
        {
          "id": "s11",
          "nom": "Strophe 11",
          "vers": "Quatrain - Octosyllabes"
        }
      ],
      "lignes": [
        {
          "n": 1,
          "strophe": "s1",
          "texte": "Au gibet noir, manchot aimable,",
          "rime": "abl",
          "procede": "Personnification du gibet « manchot aimable »",
          "effet": "Le gibet transformé en personnage grotesque et souriant.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 2,
          "strophe": "s1",
          "texte": "Dansent, dansent les paladins,",
          "rime": "in",
          "procede": "Répétition « dansent, dansent »",
          "effet": "Ronde obsessionnelle des morts.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 3,
          "strophe": "s1",
          "texte": "Les maigres paladins du diable.",
          "rime": "iabl",
          "procede": "Oxymore « paladins du diable »",
          "effet": "Chevaliers dévoyés, renversés.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 4,
          "strophe": "s1",
          "texte": "Les squelettes de Saladins.",
          "rime": "in",
          "procede": "Allégorie squelettique « squelettes de Saladins »",
          "effet": "Guerriers mauresques, morts pendus.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 5,
          "strophe": "s2",
          "texte": "Messire Belzébuth tire par la cravate",
          "rime": "at",
          "procede": "Registre féodal burlesque « Messire Belzébuth »",
          "effet": "Le diable, maître de ballet.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 6,
          "strophe": "s2",
          "texte": "Ses petits pantins noirs grimaçant sur le ciel,",
          "rime": "iel",
          "procede": "Image des « pantins noirs »",
          "effet": "Marionnettes macabres, pantins du diable.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 7,
          "strophe": "s2",
          "texte": "Et, leur claquant au front un revers de savate,",
          "rime": "at",
          "procede": "Geste trivial « revers de savate »",
          "effet": "Violence comique, dérision infernale.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 8,
          "strophe": "s2",
          "texte": "Les fait danser, danser aux sons d'un vieux Noël !",
          "rime": "oël",
          "procede": "Parodie sacrilège « vieux Noël »",
          "effet": "Parodie du sacré, ironie chrétienne.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 9,
          "strophe": "s3",
          "texte": "Et les pantins choqués enlacent leurs bras grêles :",
          "rime": "êl",
          "procede": "Danse macabre des « pantins »",
          "effet": "Danse d'amour cadavérique.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 10,
          "strophe": "s3",
          "texte": "Comme des orgues noirs, les poitrines à jour",
          "rime": "our",
          "procede": "Comparaison « comme des orgues noirs »",
          "effet": "Les côtes, tuyaux d'église profanée.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 11,
          "strophe": "s3",
          "texte": "Que serraient autrefois les gentes damoiselles,",
          "rime": "ell",
          "procede": "Ironie du passé courtois « gentes damoiselles »",
          "effet": "Amour chevaleresque retourné en cauchemar.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 12,
          "strophe": "s3",
          "texte": "Se heurtent longuement dans un hideux amour.",
          "rime": "our",
          "procede": "Oxymore « hideux amour »",
          "effet": "Parodie de l'étreinte.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 13,
          "strophe": "s4",
          "texte": "Hurrah ! Les gais danseurs, qui n'avez plus de panse !",
          "rime": "ans",
          "procede": "Exclamation burlesque « Hurrah ! »",
          "effet": "Allégresse macabre, entrain de parade.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 14,
          "strophe": "s4",
          "texte": "On peut cabrioler, les tréteaux sont si longs !",
          "rime": "ong",
          "procede": "Image des « tréteaux »",
          "effet": "Théâtre de la mort, scène foraine.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 15,
          "strophe": "s4",
          "texte": "Hop ! qu'on ne sache plus si c'est bataille ou danse !",
          "rime": "ans",
          "procede": "Confusion bataille / danse",
          "effet": "Guerre et ronde indiscernables.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 16,
          "strophe": "s4",
          "texte": "Belzébuth enragé racle ses violons !",
          "rime": "on",
          "procede": "Image du « violons » grinçants",
          "effet": "Musique infernale, stridence.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 17,
          "strophe": "s5",
          "texte": "Ô durs talons, jamais on n'use sa sandale !",
          "rime": "al",
          "procede": "Hyperbole « jamais on n'use sa sandale »",
          "effet": "Danse éternelle, supplice sans fin.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 18,
          "strophe": "s5",
          "texte": "Presque tous ont quitté la chemise de peau :",
          "rime": "eau",
          "procede": "Euphémisme anatomique « chemise de peau »",
          "effet": "La chair, vêtement abandonné.",
          "champs": [
            "macabre"
          ]
        },
        {
          "n": 19,
          "strophe": "s5",
          "texte": "Le reste est peu gênant et se voit sans scandale.",
          "rime": "al",
          "procede": "Ironie pudique « sans scandale »",
          "effet": "Décence feinte du spectacle macabre.",
          "champs": [
            "macabre"
          ]
        },
        {
